/// Nucleo-F411RE pin map (ST Morpho / Arduino + ST-Link VCP).
/// Port indices match `machine_stm32.Port` (A=0 … E=4, H=7).
module nucleo_f411re

/// User LED LD2 — PA5.
pub fn ld2_port(): i32 {
  return 0
}

pub fn ld2_pin(): i32 {
  return 5
}

/// User button B1 — PC13 (active low on Nucleo).
pub fn b1_port(): i32 {
  return 2
}

pub fn b1_pin(): i32 {
  return 13
}

/// ST-Link VCP USART2 TX — PA2 AF7.
pub fn vcp_tx_port(): i32 {
  return 0
}

pub fn vcp_tx_pin(): i32 {
  return 2
}

/// ST-Link VCP USART2 RX — PA3 AF7.
pub fn vcp_rx_port(): i32 {
  return 0
}

pub fn vcp_rx_pin(): i32 {
  return 3
}

pub fn vcp_usart(): i32 {
  return 2
}

pub fn vcp_af(): i32 {
  return 7
}

/// Arduino D14/D15 I2C1: PB9 SDA / PB8 SCL AF4.
pub fn i2c1_scl_port(): i32 {
  return 1
}

pub fn i2c1_scl_pin(): i32 {
  return 8
}

pub fn i2c1_sda_port(): i32 {
  return 1
}

pub fn i2c1_sda_pin(): i32 {
  return 9
}

pub fn i2c1_af(): i32 {
  return 4
}

/// SPI2 (example bus): PB13 SCK / PB14 MISO / PB15 MOSI AF5.
pub fn spi2_sck_port(): i32 {
  return 1
}

pub fn spi2_sck_pin(): i32 {
  return 13
}

pub fn spi2_miso_port(): i32 {
  return 1
}

pub fn spi2_miso_pin(): i32 {
  return 14
}

pub fn spi2_mosi_port(): i32 {
  return 1
}

pub fn spi2_mosi_pin(): i32 {
  return 15
}

pub fn spi2_af(): i32 {
  return 5
}

/// Arduino A0 — PA0 / ADC1_IN0.
pub fn a0_port(): i32 {
  return 0
}

pub fn a0_pin(): i32 {
  return 0
}

/// HSI 16 MHz at reset (explicit clocks — no hidden PLL).
pub fn hsi_hz(): i32 {
  return 16000000
}
